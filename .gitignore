# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Tauri build output and generated schemas. The Android project under
# src-tauri/gen/android is kept (it carries the signing setup); its own
# .gitignore files leave out what Tauri regenerates.
src-tauri/target
src-tauri/gen/schemas
src-tauri/plugins/*/permissions/autogenerated
src-tauri/plugins/*/permissions/schemas
src-tauri/plugins/*/android/build
src-tauri/plugins/*/android/.tauri
src-tauri/gen/android/build
src-tauri/gen/android/app/build

# Local environment and tool state
.env
.env.local
.env.*
.claude/
.playwright-mcp/
coverage/

# Parts exported into the project folder while testing
/*.stl
/*.3mf
/*.obj
/*.dxf
/*.svg
/*.plastikcad
/*.bashcad

# Reference robots exported for the MuJoCo smoke test
/fixtures/out

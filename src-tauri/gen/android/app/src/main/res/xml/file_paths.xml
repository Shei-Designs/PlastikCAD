<?xml version="1.0" encoding="utf-8"?>
<!-- What the app may hand to other apps as a file of its own: only what it staged for sharing (cache/share, written by
     stage_share). Exports are shared by the content URIs the media store gave them, which need no entry here. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="share" path="share/" />
</paths>

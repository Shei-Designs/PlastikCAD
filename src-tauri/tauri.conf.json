{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlastikCAD",
  "mainBinaryName": "plastikcad",
  "version": "0.2.2",
  "identifier": "com.sheidesigns.plastikcad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlastikCAD",
        "width": 1480,
        "height": 900,
        "minWidth": 1320,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: https://oauth2.googleapis.com https://www.googleapis.com; base-uri 'self'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Fast solid modelling for 3D printing",
    "license": "GPL-3.0-or-later",
    "publisher": "Shei Designs",
    "homepage": "https://sheidesigns.com",
    "copyright": "Copyright © 2026 Andrew O'Shei, Shei Designs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["plastikcad", "bashcad"],
        "name": "PlastikCAD design",
        "description": "PlastikCAD design",
        "mimeType": "application/x-plastikcad",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.sheidesigns.plastikcad.design",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGODQ2NkRCOEVCMTM0MEIKUldRTE5MR08yMmFFdnh0UXBZTG5INjl3RDFsdTJuNHdSZWZlMWxmS25ENmtOMEhoc3hKNzBUZ2gK",
      "endpoints": ["https://github.com/Shei-Designs/PlastikCAD/releases/latest/download/latest.json"]
    }
  }
}

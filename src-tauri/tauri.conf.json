{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BashCAD",
  "mainBinaryName": "bashcad",
  "version": "0.1.0",
  "identifier": "com.andrewoshei.bashcad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BashCAD",
        "width": 1480,
        "height": 900,
        "minWidth": 1320,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: https://oauth2.googleapis.com https://www.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Fast solid modelling for 3D printing",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["bashcad"],
        "name": "BashCAD design",
        "description": "BashCAD design",
        "mimeType": "application/x-bashcad",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.andrewoshei.bashcad.design",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}

    "@tauri-apps/plugin-dialog": "^2",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
